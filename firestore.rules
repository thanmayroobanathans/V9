rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMember(matchId) {
      return signedIn()
        && request.auth.uid in
        get(
          /databases/$(database)/documents/matches/$(matchId)
        ).data.memberUids;
    }


    // =====================================================
    // USER DATA
    // =====================================================

    match /users/{uid} {

      // User's own profile/root document
      allow read, create, update:
        if self(uid);

      allow delete:
        if false;


      // ===================================================
      // PERSONALITY RESULTS
      // users/{uid}/results/{resultId}
      // ===================================================

      match /results/{resultId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // QUESTIONNAIRE SESSIONS
      // users/{uid}/sessions/{sessionId}
      // ===================================================

      match /sessions/{sessionId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // INDIVIDUAL RESPONSES
      // users/{uid}/responses/{questionId}
      // ===================================================

      match /responses/{questionId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // PRECISE GPS LOCATION
      // users/{uid}/location/{locationId}
      // ===================================================

      match /location/{locationId} {

        // Only the owner can access precise coordinates.
        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // USER PREFERENCES
      // users/{uid}/preferences/{preferenceId}
      // ===================================================

      match /preferences/{preferenceId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }
    }


    // =====================================================
    // PUBLIC PROFILES (V9.1 explore)
    // publicProfiles/{uid} — what other signed-in students see.
    // Location is coarse (3 decimals ~ 110 m). No email, no precise GPS.
    // =====================================================

    function coarseLoc(loc) {
      return loc == null
        || (loc.keys().hasOnly(['lat', 'lng'])
            && loc.lat is number && loc.lng is number);
    }

    match /publicProfiles/{uid} {

      allow read:
        if signedIn();

      allow create, update:
        if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.bio.size() <= 200
        && request.resource.data.status.size() <= 80
        && request.resource.data.vector.size() == 11
        && coarseLoc(request.resource.data.get('loc', null))
        && !('email' in request.resource.data)
        && !('latitude' in request.resource.data)
        && !('longitude' in request.resource.data);

      allow delete:
        if self(uid);
    }


    // =====================================================
    // DIRECT CHATS
    // chats/{uidA}_{uidB} (uids sorted)
    // =====================================================

    function isChatMember(chatId) {
      return signedIn()
        && request.auth.uid in
        get(/databases/$(database)/documents/chats/$(chatId)).data.memberUids;
    }

    match /chats/{chatId} {

      allow read:
        if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberUids);

      allow create:
        if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2
        && chatId == request.resource.data.memberUids[0] + '_' + request.resource.data.memberUids[1];

      allow update:
        if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt']);

      allow delete:
        if false;

      match /messages/{messageId} {

        allow read:
          if isChatMember(chatId);

        allow create:
          if isChatMember(chatId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update, delete:
          if false;
      }
    }


    // =====================================================
    // PLACES (hangout spots) + their public rooms
    // =====================================================

    match /places/{placeId} {

      allow read:
        if signedIn();

      allow create:
        if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && coarseLoc(request.resource.data.loc);

      allow update, delete:
        if false;

      match /messages/{messageId} {

        allow read:
          if signedIn();

        allow create:
          if signedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update, delete:
          if false;
      }
    }


    // =====================================================
    // PLACE VIBES
    // =====================================================

    match /placeVibes/{placeId} {

      allow read:
        if signedIn();

      allow create:
        if signedIn();

      // Prevent users from modifying/deleting
      // previously submitted research signals.
      allow update, delete:
        if false;
    }


    // =====================================================
    // RESEARCH AGGREGATES
    // =====================================================

    match /aggregateFingerprints/{fingerprintId} {

      allow create:
        if signedIn();

      allow read, update, delete:
        if false;
    }


    // =====================================================
    // DENY EVERYTHING ELSE
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}