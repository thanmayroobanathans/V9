rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMember(matchId) {
      return signedIn()
        && request.auth.uid in
        get(
          /databases/$(database)/documents/matches/$(matchId)
        ).data.memberUids;
    }


    // =====================================================
    // USER DATA
    // =====================================================

    match /users/{uid} {

      // User's own profile/root document
      allow read, create, update:
        if self(uid);

      allow delete:
        if false;


      // ===================================================
      // PERSONALITY RESULTS
      // users/{uid}/results/{resultId}
      // ===================================================

      match /results/{resultId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // QUESTIONNAIRE SESSIONS
      // users/{uid}/sessions/{sessionId}
      // ===================================================

      match /sessions/{sessionId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // INDIVIDUAL RESPONSES
      // users/{uid}/responses/{questionId}
      // ===================================================

      match /responses/{questionId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // PRECISE GPS LOCATION
      // users/{uid}/location/{locationId}
      // ===================================================

      match /location/{locationId} {

        // Only the owner can access precise coordinates.
        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // USER PREFERENCES
      // users/{uid}/preferences/{preferenceId}
      // ===================================================

      match /preferences/{preferenceId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }
    }


    // =====================================================
    // PUBLIC DATING PROFILES (V9)
    // publicProfiles/{uid} — what other signed-in students see.
    // Contains no email and no coordinates.
    // =====================================================

    match /publicProfiles/{uid} {

      allow read:
        if signedIn();

      allow create, update:
        if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.bio.size() <= 240
        && request.resource.data.vector.size() == 11
        && !('email' in request.resource.data)
        && !('latitude' in request.resource.data)
        && !('longitude' in request.resource.data);

      allow delete:
        if self(uid);
    }


    // =====================================================
    // SWIPES (likes / super likes / passes)
    // connections/{fromUid}_{toUid}
    // =====================================================

    match /connections/{connectionId} {

      // Sender and recipient may read. resource == null lets a client check
      // whether a reciprocal like exists without leaking anything.
      allow read:
        if signedIn()
        && (
          resource == null
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );

      // Only the swiper writes, and only under their own deterministic id.
      allow create, update:
        if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && connectionId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.type in ['like', 'super', 'pass'];

      allow delete:
        if false;
    }


    // =====================================================
    // MATCHES
    // matches/{uidA}_{uidB} (uids sorted)
    // =====================================================

    function liked(fromUid, toUid) {
      let c = /databases/$(database)/documents/connections/$(fromUid + '_' + toUid);
      return exists(c) && get(c).data.type in ['like', 'super'];
    }

    match /matches/{matchId} {

      allow read:
        if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberUids);

      // A match can only be created when both people really liked each other.
      allow create:
        if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2
        && matchId == request.resource.data.memberUids[0] + '_' + request.resource.data.memberUids[1]
        && liked(request.resource.data.memberUids[0], request.resource.data.memberUids[1])
        && liked(request.resource.data.memberUids[1], request.resource.data.memberUids[0]);

      // Members may update the preview / close the match, never change membership.
      allow update:
        if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastAt', 'status']);

      allow delete:
        if false;


      // ===================================================
      // MATCH MESSAGES
      // ===================================================

      match /messages/{messageId} {

        allow read:
          if isMember(matchId);

        allow create:
          if isMember(matchId)
          && get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'open'
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update, delete:
          if false;
      }
    }


    // =====================================================
    // PLACE VIBES
    // =====================================================

    match /placeVibes/{placeId} {

      allow read:
        if signedIn();

      allow create:
        if signedIn();

      // Prevent users from modifying/deleting
      // previously submitted research signals.
      allow update, delete:
        if false;
    }


    // =====================================================
    // RESEARCH AGGREGATES
    // =====================================================

    match /aggregateFingerprints/{fingerprintId} {

      allow create:
        if signedIn();

      allow read, update, delete:
        if false;
    }


    // =====================================================
    // DENY EVERYTHING ELSE
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}