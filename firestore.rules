rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================

    function signedIn() {
      return request.auth != null;
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isMember(matchId) {
      return signedIn()
        && request.auth.uid in
        get(
          /databases/$(database)/documents/matches/$(matchId)
        ).data.memberUids;
    }


    // =====================================================
    // USER DATA
    // =====================================================

    match /users/{uid} {

      // User's own profile/root document
      allow read, create, update:
        if self(uid);

      allow delete:
        if false;


      // ===================================================
      // PERSONALITY RESULTS
      // users/{uid}/results/{resultId}
      // ===================================================

      match /results/{resultId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // QUESTIONNAIRE SESSIONS
      // users/{uid}/sessions/{sessionId}
      // ===================================================

      match /sessions/{sessionId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // INDIVIDUAL RESPONSES
      // users/{uid}/responses/{questionId}
      // ===================================================

      match /responses/{questionId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // PRECISE GPS LOCATION
      // users/{uid}/location/{locationId}
      // ===================================================

      match /location/{locationId} {

        // Only the owner can access precise coordinates.
        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }


      // ===================================================
      // USER PREFERENCES
      // users/{uid}/preferences/{preferenceId}
      // ===================================================

      match /preferences/{preferenceId} {

        allow read, create, update:
          if self(uid);

        allow delete:
          if false;
      }
    }


    // =====================================================
    // PUBLIC PROFILES
    // publicProfiles/{uid} — what other signed-in students see.
    // No email and no coordinates of any kind: location is only used on the
    // device to derive lifestyle features (`nature`) and a ~1.2 km `area` code.
    // =====================================================

    function validSignals(d) {
      return (!('area' in d) || d.area == null || (d.area is string && d.area.size() <= 6))
        && (!('nature' in d) || d.nature == null
            || (d.nature is map && d.nature.keys().hasOnly(['roam', 'variety', 'routine', 'active', 'night', 'early', 'confidence'])));
    }

    match /publicProfiles/{uid} {

      allow read:
        if signedIn();

      allow create, update:
        if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.bio.size() <= 200
        && request.resource.data.status.size() <= 80
        && request.resource.data.vector.size() == 11
        && validSignals(request.resource.data)
        && !('loc' in request.resource.data)
        && !('email' in request.resource.data)
        && !('latitude' in request.resource.data)
        && !('longitude' in request.resource.data);

      allow delete:
        if self(uid);
    }


    // =====================================================
    // SWIPES (like / super / pass)
    // connections/{fromUid}_{toUid}
    // =====================================================

    match /connections/{connectionId} {

      // resource == null lets a client check for a reciprocal like without leaking anything.
      allow read:
        if signedIn()
        && (
          resource == null
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );

      allow create, update:
        if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && connectionId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.type in ['like', 'super', 'pass'];

      allow delete:
        if false;
    }


    // =====================================================
    // MATCHES — matches/{uidA}_{uidB} (uids sorted)
    // Only created when both people really liked each other.
    // =====================================================

    function liked(fromUid, toUid) {
      let c = /databases/$(database)/documents/connections/$(fromUid + '_' + toUid);
      return exists(c) && get(c).data.type in ['like', 'super'];
    }

    match /matches/{matchId} {

      allow read:
        if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberUids);

      allow create:
        if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2
        && matchId == request.resource.data.memberUids[0] + '_' + request.resource.data.memberUids[1]
        && liked(request.resource.data.memberUids[0], request.resource.data.memberUids[1])
        && liked(request.resource.data.memberUids[1], request.resource.data.memberUids[0]);

      allow update:
        if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSender', 'lastAt', 'status'])
        && (!('lastSender' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastSender == request.auth.uid);

      allow delete:
        if false;

      match /messages/{messageId} {

        allow read:
          if isMember(matchId);

        allow create:
          if isMember(matchId)
          && get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'open'
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update, delete:
          if false;
      }
    }


    // =====================================================
    // PLACE VIBES
    // =====================================================

    match /placeVibes/{placeId} {

      allow read:
        if signedIn();

      allow create:
        if signedIn();

      // Prevent users from modifying/deleting
      // previously submitted research signals.
      allow update, delete:
        if false;
    }


    // =====================================================
    // RESEARCH AGGREGATES
    // =====================================================

    match /aggregateFingerprints/{fingerprintId} {

      allow create:
        if signedIn();

      allow read, update, delete:
        if false;
    }


    // =====================================================
    // DENY EVERYTHING ELSE
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}