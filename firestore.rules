rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // HELPERS
    // =====================================================

    // Only verified @vitstudent.ac.in Google accounts can use the app.
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@vitstudent[.]ac[.]in$');
    }

    function self(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // viewer has an ACCEPTED follow of owner
    function follows(viewer, owner) {
      let f = /databases/$(database)/documents/follows/$(viewer + '_' + owner);
      return exists(f) && get(f).data.status == 'accepted';
    }

    function canSeePrivate(owner) {
      return self(owner) || (signedIn() && follows(request.auth.uid, owner));
    }

    function isMember(matchId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.memberUids;
    }


    // =====================================================
    // PRIVATE USER DATA — users/{uid}
    // =====================================================

    match /users/{uid} {

      allow read, create, update, delete:
        if self(uid);

      match /results/{resultId} {
        allow read, create, update, delete: if self(uid);
      }

      match /preferences/{preferenceId} {
        allow read, create, update, delete: if self(uid);
      }

      match /sessions/{sessionId} {
        allow read, create, update, delete: if self(uid);
      }

      match /responses/{questionId} {
        allow read, create, update, delete: if self(uid);
      }

      match /location/{locationId} {
        allow read, create, update, delete: if self(uid);
      }

      // ---------------------------------------------------
      // POSTS — only the owner and accepted followers
      // ---------------------------------------------------
      match /posts/{postId} {

        allow read:
          if canSeePrivate(uid);

        allow create:
          if self(uid)
          && request.resource.data.uid == uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && (request.resource.data.image == null
              || (request.resource.data.image is string && request.resource.data.image.size() < 400000));

        allow update:
          if false;

        allow delete:
          if self(uid);

        match /likes/{likerUid} {

          allow read:
            if canSeePrivate(uid);

          allow create:
            if signedIn()
            && likerUid == request.auth.uid
            && canSeePrivate(uid);

          allow delete:
            if signedIn() && (likerUid == request.auth.uid || self(uid));

          allow update:
            if false;
        }
      }
    }


    // =====================================================
    // USERNAMES — usernames/{handle} → { uid }
    // =====================================================

    match /usernames/{handle} {

      allow read:
        if signedIn();

      allow create:
        if signedIn()
        && request.resource.data.uid == request.auth.uid
        && handle.matches('^[a-z0-9._]{3,20}$');

      allow delete:
        if signedIn() && resource.data.uid == request.auth.uid;

      allow update:
        if false;
    }


    // =====================================================
    // PUBLIC PROFILES — the swipe card
    // No email, no coordinates. Username must be one the user owns.
    // =====================================================

    function validSignals(d) {
      return (!('area' in d) || d.area == null || (d.area is string && d.area.size() <= 6))
        && (!('nature' in d) || d.nature == null
            || (d.nature is map && d.nature.keys().hasOnly(['roam', 'variety', 'routine', 'active', 'night', 'early', 'confidence'])));
    }

    match /publicProfiles/{uid} {

      allow read:
        if signedIn();

      allow create, update:
        if self(uid)
        && request.resource.data.uid == uid
        && request.resource.data.username is string
        && exists(/databases/$(database)/documents/usernames/$(request.resource.data.username))
        && get(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 24
        && request.resource.data.bio.size() <= 200
        && request.resource.data.status.size() <= 80
        && request.resource.data.vector.size() == 11
        && (request.resource.data.photoURL == null
            || (request.resource.data.photoURL is string && request.resource.data.photoURL.size() < 80000))
        && validSignals(request.resource.data)
        && !('loc' in request.resource.data)
        && !('email' in request.resource.data)
        && !('latitude' in request.resource.data)
        && !('longitude' in request.resource.data);

      allow delete:
        if self(uid);
    }


    // =====================================================
    // FOLLOW REQUESTS — follows/{fromUid}_{toUid}
    // Visible only to the two people involved.
    // =====================================================

    match /follows/{followId} {

      allow read:
        if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create:
        if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending';

      // Only the person being followed can accept.
      allow update:
        if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);

      // Either side can cancel / remove.
      allow delete:
        if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }


    // =====================================================
    // SWIPES — connections/{fromUid}_{toUid}
    // =====================================================

    match /connections/{connectionId} {

      allow read:
        if signedIn()
        && (
          resource == null
          || resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid
        );

      allow create, update:
        if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && connectionId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.type in ['like', 'super', 'pass'];

      allow delete:
        if false;
    }


    // =====================================================
    // CHATS — matches/{uidA}_{uidB} (uids sorted)
    // Open after a mutual like OR an accepted follow request.
    // =====================================================

    function liked(fromUid, toUid) {
      let c = /databases/$(database)/documents/connections/$(fromUid + '_' + toUid);
      return exists(c) && get(c).data.type in ['like', 'super'];
    }

    match /matches/{matchId} {

      allow read:
        if signedIn()
        && (resource == null || request.auth.uid in resource.data.memberUids);

      allow create:
        if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == 2
        && matchId == request.resource.data.memberUids[0] + '_' + request.resource.data.memberUids[1]
        && (
          (liked(request.resource.data.memberUids[0], request.resource.data.memberUids[1])
            && liked(request.resource.data.memberUids[1], request.resource.data.memberUids[0]))
          || follows(request.resource.data.memberUids[0], request.resource.data.memberUids[1])
          || follows(request.resource.data.memberUids[1], request.resource.data.memberUids[0])
        );

      allow update:
        if signedIn()
        && request.auth.uid in resource.data.memberUids
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastSender', 'lastAt', 'status'])
        && (!('lastSender' in request.resource.data.diff(resource.data).affectedKeys())
            || request.resource.data.lastSender == request.auth.uid);

      allow delete:
        if false;

      match /messages/{messageId} {

        allow read:
          if isMember(matchId);

        allow create:
          if isMember(matchId)
          && get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'open'
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update, delete:
          if false;
      }
    }


    // =====================================================
    // REPORTS — grievance mechanism (write-only for users)
    // =====================================================

    match /reports/{reportId} {

      allow create:
        if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.detail.size() <= 1000;

      allow read, update, delete:
        if false;
    }


    // =====================================================
    // DENY EVERYTHING ELSE
    // =====================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
